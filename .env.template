BOT_TOKEN=BOT:TOKEN
REPORT_TIMEZONE=Europe/Moscow
# Для запуска без Docker. В Compose база всегда находится в ./data на сервере.
DB_PATH=./data/pushups.sqlite3
DAILY_TARGET=30
# Пустая история подходит для новой группы. Для другой старой группы можно указать даты и нормы.
DAILY_TARGET_HISTORY=
CASH_FINE=1000000

GEMINI_API_KEY=API:KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Необязательно: путь к файлу промпта (внутри контейнера по умолчанию /app/prompt.txt).
# GEMINI_PROMPT_PATH=/app/prompt.txt
# Права владельца имеет полный доступ ко всему
OWNER_ID=123456789

# Разрешённые группы
ALLOWED_CHAT_IDS=-1001234567890
# Пользователи, которым можно писать боту в личку и получать личные отчеты
ALLOWED_USER_IDS=111111111,222222222
#
